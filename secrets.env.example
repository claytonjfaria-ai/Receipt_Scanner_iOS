# Template only — copy to secrets.env (gitignored) and fill in real values, then:
#   source secrets.env && xcodegen generate
# before building or archiving. Mirrors the Android app's local.properties.example
# convention; see Sources/Secrets.swift and project.yml for how these actually get in.
#
# Where to get these: Supabase dashboard → Settings → API, for tap2know-dev (recommended
# for day-to-day testing — same dev-first convention Android's DEVELOPMENT.md uses;
# extract-bill is deployed and GEMINI_API_KEY provisioned on both tap2know-dev and
# tap2know-prod as of 2026-08-21, so dev is fully functional for this).
export SUPABASE_URL="https://your-project.supabase.co"
export SUPABASE_ANON_KEY="your-anon-key"
