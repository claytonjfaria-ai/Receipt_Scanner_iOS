# Generated by xcodegen — never hand-edited, never committed.
*.xcodeproj/
*.xcworkspace/

# Generated by xcodegen from project.yml
Support/Info.plist

# Real Supabase URL/anon key, sourced before `xcodegen generate`. Mirrors Android's
# local.properties: gitignored, never committed, filled in locally from
# secrets.env.example. CI has no copy of this file — it builds fine without one
# (Secrets.swift treats the unsubstituted ${VAR} placeholder as "not configured"), it
# just can't reach a live Supabase project until real values are sourced before signing.
secrets.env

build/
DerivedData/
Payload/
*.ipa
.DS_Store
